{
  "name": "personal-ai-engineering-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Portable agent skills with local validation and installation checks",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "skills": "skills",
    "validate": "node scripts/validate-skills.mjs",
    "typecheck": "tsc --noEmit",
    "inspect:project": "node skills/production-quality-code/scripts/inspect-project.mts",
    "test": "node --test tests/*.test.mjs",
    "test:install": "node scripts/test-install.mjs",
    "check": "npm run validate && npm run typecheck && npm test && npm run test:install"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "skills": "1.9.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
