{
  "name": "personal-ai-engineering-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Portable agent skills with local validation and installation checks",
  "type": "module",
  "bin": {
    "senior-engineering-skills": "bin/senior-engineering-skills.mjs"
  },
  "files": [
    "bin", "AGENTS.md", "VERSION.md", "adapters", "checklists", "docs", "examples", "glossary",
    "instructions", "knowledge", "prompts", "rules", "skills", "standards", "templates", "workflows"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "skills": "skills",
    "validate": "node scripts/validate-skills.mjs",
    "typecheck": "tsc --noEmit && tsc -p templates",
    "inspect:project": "node skills/production-quality-code/scripts/inspect-project.mts",
    "framework": "node bin/senior-engineering-skills.mjs framework",
    "test": "node --test tests/*.test.mjs",
    "test:install": "node scripts/test-install.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run validate && npm run typecheck && npm test && npm run test:package && npm run test:install"
  },
  "dependencies": {
    "skills": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
